{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-phase17/types/**/*.ts",
    ".next-phase17/dev/types/**/*.ts",
    ".next-phase18/types/**/*.ts",
    ".next-phase18/dev/types/**/*.ts",
    ".next-phase19/types/**/*.ts",
    ".next-phase19/dev/types/**/*.ts",
    ".next-phase20/types/**/*.ts",
    ".next-phase20/dev/types/**/*.ts",
    ".next-phase21/types/**/*.ts",
    ".next-phase21/dev/types/**/*.ts",
    ".next-phase21-final/types/**/*.ts",
    ".next-phase21-final/dev/types/**/*.ts",
    ".next-phase21-release/types/**/*.ts",
    ".next-phase21-release/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
