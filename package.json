{
  "name": "serendipity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-database.mjs && node scripts/serve.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/ensure-database.mjs && node scripts/serve.mjs start",
    "start:test": "node scripts/start-test-server.mjs",
    "db:migrate": "node scripts/ensure-database.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-isolated-tests.mjs",
    "test:e2e": "next build --webpack && playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@prisma/client": "^6.12.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "playwright": "^1.64.0",
    "prisma": "^6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.3"
  }
}
