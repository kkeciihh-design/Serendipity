{
  "name": "serendipity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-database.mjs && next dev -p 3000",
    "build": "next build --webpack",
    "start": "node scripts/ensure-database.mjs && next start -p 3000",
    "start:test": "node scripts/ensure-database.mjs && next start -p 3100",
    "db:migrate": "node scripts/ensure-database.mjs",
    "verify:phase03": "node scripts/verify-phase03.mjs",
    "verify:phase04": "node scripts/verify-phase04.mjs",
    "verify:phase05": "node scripts/verify-phase05.mjs",
    "verify:phase06": "node scripts/verify-phase06.mjs",
    "capture:phase05": "node scripts/capture-phase05-screens.mjs",
    "capture:phase06": "node scripts/capture-phase06-screens.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build --webpack && playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "prisma": "^6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.3"
  }
}
